# Used by GoReleaser (see ../.goreleaser.yaml): copies the prebuilt binary, nothing is compiled here.
# The development image, built from source with docker build, is controller/Dockerfile.
FROM gcr.io/distroless/static:nonroot
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/skill-ci-controller /manager
USER 65532:65532
EXPOSE 8080 8081 8082
ENTRYPOINT ["/manager"]
