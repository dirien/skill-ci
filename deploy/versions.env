# Single source of versions for the vanilla (Helm + kubectl) deployment path.
# deploy/install.sh, deploy/generate.sh and deploy/README.md read it; nothing else repeats these values.
# infra/Pulumi.yaml must use the same values: run deploy/check-versions.sh.

# kubernetes-sigs Agent Sandbox release (sandbox-with-extensions.yaml).
AGENT_SANDBOX_VERSION=v1.0.9
# goharbor Helm chart.
HARBOR_CHART_VERSION=1.19.4
# kube-prometheus-stack Helm chart.
KUBE_PROMETHEUS_STACK_VERSION=92.10.1
# Toolbox images: oras and curl (Harbor REST API and the Harbor setup Job).
ORAS_VERSION=v1.3.0
CURL_VERSION=8.14.1

# One skill-ci release: the controller chart (oci://ghcr.io/dirien/charts/skill-ci-controller), the controller,
# runner and sandbox images (ghcr.io/dirien/skill-ci-{controller,runner,sandbox}) all carry this version.
# Needs the first release that publishes the sandbox image.
SKILL_CI_VERSION=0.8.1
